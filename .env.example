# Copy this file to .env and change what you need.
# .env is ignored by git: never commit real credentials.

# --- Where the data comes from -------------------------------------------
# mock = built-in sample data, no connection to any Pinkbee instance (default)
# live = a real Pinkbee instance, read-only
PINKBEE_DATA_SOURCE=mock

# Only needed when PINKBEE_DATA_SOURCE=live.
# Use an account that only needs to read the roster.
# Must be https: logging in sends the password, so plain http is refused.
PINKBEE_BASE_URL=https://your-organisation.mijnpinkbee.nl
PINKBEE_LOGIN=
PINKBEE_PASSWORD=

# Allows plain http, and only towards this machine, for a local test Pinkbee.
# Leave this off unless that is exactly what you are doing.
PINKBEE_ALLOW_INSECURE_HTTP_TO_LOCALHOST=false

# --- Personal data --------------------------------------------------------
# Two tools return names and email addresses (pinkbee_list_group_emails and
# pinkbee_list_registrations). They stay switched off until you set this.
PINKBEE_ALLOW_PERSONAL_DATA=false

# --- Who can use the MCP server -------------------------------------------

# Clients must send this as: Authorization: Bearer <token>
# Leave empty only on a network you fully trust.
# Make one with: openssl rand -hex 32
PINKBEE_MCP_TOKEN=

# Empty allows every sender that can reach port 8087 (the default).
# To restrict access, list exact sender IPs or DNS names, comma separated.
# This is the IP/name of the client or service MAKING the MCP request, not the
# address of the machine running this container.
# Example: PINKBEE_ALLOWED_SENDERS=192.168.1.42,agent.domain.example.com
PINKBEE_ALLOWED_SENDERS=

# Empty enables every call. To disable calls, list their full names, comma separated.
# Example: PINKBEE_DISABLED_CALLS=pinkbee_list_group_emails,pinkbee_list_registrations
PINKBEE_DISABLED_CALLS=

# --- Other settings -------------------------------------------------------
# "Today" is worked out in this timezone, not the container's UTC clock.
PINKBEE_TIMEZONE=Europe/Amsterdam
PINKBEE_TIMEOUT_SECONDS=20
# DEBUG, INFO, WARNING or ERROR
# Warning: DEBUG will log all personal data, if you have allowed it.
PINKBEE_LOG_LEVEL=INFO
