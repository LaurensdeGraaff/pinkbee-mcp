# Copy this file to .env and change what you need.
# .env is ignored by git: never commit real credentials.

# --- Where the data comes from -------------------------------------------
# mock = built-in sample data, no connection to any Pinkbee instance (default)
# live = a real Pinkbee instance, read-only
PINKBEE_DATA_SOURCE=mock

# Only needed when PINKBEE_DATA_SOURCE=live.
# Use an account that only needs to read the roster.
# Must be https: logging in sends the password, so plain http is refused.
PINKBEE_BASE_URL=https://your-organisation.mijnpinkbee.nl
PINKBEE_LOGIN=
PINKBEE_PASSWORD=

# Allows plain http, and only towards this machine, for a local test Pinkbee.
# Leave this off unless that is exactly what you are doing.
PINKBEE_ALLOW_INSECURE_HTTP_TO_LOCALHOST=false

# --- Personal data --------------------------------------------------------
# Two tools return names and email addresses (pinkbee_list_group_emails and
# pinkbee_list_registrations). They stay switched off until you set this.
PINKBEE_ALLOW_PERSONAL_DATA=false

# --- How the MCP server is reachable --------------------------------------
# streamable-http (what the container uses) or stdio (local desktop client)
PINKBEE_MCP_TRANSPORT=streamable-http
PINKBEE_MCP_HOST=0.0.0.0
PINKBEE_MCP_PORT=8080
PINKBEE_MCP_PATH=/mcp

# Clients must send this as: Authorization: Bearer <token>
# Leave empty only on a network you fully trust.
# Make one with: openssl rand -hex 32
PINKBEE_MCP_TOKEN=

# Extra Origin and Host values to accept, comma separated. localhost is always
# allowed, so leave both empty if you only use this server from this machine.
# Anything not listed gets 403 (Origin) or 421 (Host).
#
# Behind a reverse proxy on https://mcp.example.org:
#   PINKBEE_ALLOWED_HOSTS=mcp.example.org,mcp.example.org:*
#   PINKBEE_ALLOWED_ORIGINS=https://mcp.example.org,https://mcp.example.org:*
#
# Reachable at a fixed address on your network, say 192.168.1.50:8087:
#   PINKBEE_ALLOWED_HOSTS=192.168.1.50,192.168.1.50:*
#   PINKBEE_ALLOWED_ORIGINS=http://192.168.1.50,http://192.168.1.50:*
#
# Match is exact, apart from a ":*" port wildcard. So no subdomain wildcards, no
# trailing slash, and the scheme matters. List the name both with and without ":*",
# because ":*" only matches when a port is actually present.
# Full explanation and more examples: docs/deploying.md
PINKBEE_ALLOWED_ORIGINS=
PINKBEE_ALLOWED_HOSTS=

# --- Limits on one tool call ---------------------------------------------
# These keep a single call from exporting months of personal data, or producing an
# answer too large to be useful.
PINKBEE_MAX_REGISTRATION_DAYS=120
PINKBEE_MAX_IDS_PER_FILTER=50
PINKBEE_MAX_DATES=12
PINKBEE_MAX_WEEKS=12

# --- Other settings -------------------------------------------------------
# "Today" is worked out in this timezone, not the container's UTC clock.
PINKBEE_TIMEZONE=Europe/Amsterdam
PINKBEE_TIMEOUT_SECONDS=20
# DEBUG, INFO, WARNING or ERROR
# Warning: DEBUG will log all personal data, if you have allowed it.
PINKBEE_LOG_LEVEL=INFO
